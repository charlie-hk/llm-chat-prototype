# Copy to .env and fill in. The app runs without any of this using the mock provider.

# mock | openai | anthropic | gemini
PROVIDER=mock

# Model name for the chosen provider, e.g.
#   openai     -> gpt-4o-mini
#   anthropic  -> claude-3-5-sonnet-latest
#   gemini     -> gemini-1.5-flash
MODEL=

# API key for the chosen provider (leave blank for mock)
API_KEY=

# The assistant's persona / instructions
SYSTEM_PROMPT=You are a helpful, concise assistant.

# Keep only the last N messages that are sent to the model (context window control)
MAX_HISTORY=20

# Comma-separated origins allowed to call the API (the frontend dev server)
CORS_ORIGINS=http://localhost:5173
